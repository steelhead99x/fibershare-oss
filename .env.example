# Copy to .env for `npm run chirpstack:pull`. .env is ignored by git.
# Leave a line blank to use the default.

# ChirpStack REST API gateway. Default: http://localhost:8090
CHIRPSTACK_URL=
# API token from the ChirpStack web UI. Or leave blank and put the token in
# CHIRPSTACK_API_TOKEN_FILE (default ~/.config/fibershare/chirpstack-token).
CHIRPSTACK_API_TOKEN=
CHIRPSTACK_API_TOKEN_FILE=
# Optional, comma separated, to read only some tenants or applications.
CHIRPSTACK_TENANT_ID=
CHIRPSTACK_APPLICATION_ID=
# Optional, only if the REST gateway sits behind Cloudflare Access.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
# Optional, for decoded uplinks (position, temperature, light, motion, SOS).
CHIRPSTACK_MQTT_URL=
CHIRPSTACK_MQTT_USERNAME=
CHIRPSTACK_MQTT_PASSWORD=
# 1 (default) hides tracker details before writing. 0 keeps real values.
FIBERSHARE_HIDE_TRACKERS=1
# 1 turns off the plain-http warning, for a private network you trust.
CHIRPSTACK_ALLOW_HTTP=

# Rancher sign-in, local mode: set the passphrase with `npm run rancher:passphrase`.
# serve:local listens on 127.0.0.1:4174 unless you change these.
FIBERSHARE_HOST=
FIBERSHARE_PORT=

# Optional ArcGIS location services key, for the Esri basemaps. Sent only to a
# signed-in rancher. Every other map layer works without it. Use a
# Limit it to the basemaps privilege only. Leave this blank
# in the repository.
ARCGIS_API_KEY=

# For `npm run chirpstack:pull -- --push` to your Cloudflare Pages copy.
# The token can live in FIBERSHARE_PUSH_TOKEN_FILE instead
# (default ~/.config/fibershare/push-token).
FIBERSHARE_PUSH_URL=
FIBERSHARE_PUSH_TOKEN=
FIBERSHARE_PUSH_TOKEN_FILE=
